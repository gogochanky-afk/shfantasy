+def _benchmark_snapshot_hash(slate: DailyBlitzSlate, playable: list[str], roster_size: int) -> str:
+    payload = {
+        "sport": slate.sport,
+        "slate_id": slate.slate_id,
+        "season_id": RANK_SEASON_ID,
+        "rules_version": RANK_RULES_VERSION,
+        "benchmark_version": RANK_BENCHMARK_VERSION,
+        "roster_size": roster_size,
+        "players": [
+            {
+                "player_id": player_id,
+                "team_id": slate.players[player_id].team_id,
+                "tier": slate.salaries[player_id].tier,
+                "status": slate.statuses[player_id].status if slate.statuses.get(player_id) else "available",
+            }
+            for player_id in playable
+        ],
+    }
+    return hashlib.sha256(json.dumps(payload, sort_keys=True, separators=(",", ":")).encode("utf-8")).hexdigest()
+
+
+def _benchmark_field_snapshot_id(slate: DailyBlitzSlate, roster_size: int) -> str:
+    seed = f"{slate.sport}:{slate.slate_id}:{RANK_SEASON_ID}:{RANK_RULES_VERSION}:{RANK_BENCHMARK_VERSION}:{roster_size}"
+    return f"dbb_{hashlib.sha256(seed.encode('utf-8')).hexdigest()[:16]}"
+
