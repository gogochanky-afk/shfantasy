 export const API_BASE = import.meta.env.VITE_API_BASE || '/shfantasy-api';
+const DEV_HEADER_AUTH =
+  import.meta.env.DEV || import.meta.env.VITE_SHFANTASY_AUTH_MODE === 'dev';
+const DEV_USER_STORAGE_KEY = 'shfantasyUserId';
+
+export function getDevUserId() {
+  if (!DEV_HEADER_AUTH || typeof localStorage === 'undefined') return '';
+  const existing = localStorage.getItem(DEV_USER_STORAGE_KEY);
+  if (existing) return existing;
+  const generated =
+    typeof crypto !== 'undefined' && 'randomUUID' in crypto
+      ? `guest-${crypto.randomUUID()}`
+      : `guest-${Date.now().toString(36)}`;
+  localStorage.setItem(DEV_USER_STORAGE_KEY, generated);
+  return generated;
+}

 function requestHeaders(options: RequestInit) {
   const headers = new Headers(options.headers || {});
   if (!headers.has('Content-Type')) headers.set('Content-Type', 'application/json');
-  if (typeof localStorage !== 'undefined' && !headers.has('X-SHF-User-ID')) {
-    headers.set('X-SHF-User-ID', localStorage.getItem('shfantasyUserId') || 'hugo');
+  const devUserId = getDevUserId();
+  if (devUserId && !headers.has('X-SHF-User-ID')) {
+    headers.set('X-SHF-User-ID', devUserId);
   }
   return headers;
 }
