     return {"grade": "C", "title": "Training Run"}
 
 
+def _tier_for_points(points: int) -> dict[str, object]:
+    tier = RANK_TIERS[0]
+    for candidate in RANK_TIERS:
+        if points >= int(candidate["floor"]):
+            tier = candidate
+    return tier
+
+
+def _next_tier(points: int) -> dict[str, object] | None:
+    for candidate in RANK_TIERS:
+        if points < int(candidate["floor"]):
+            return candidate
+    return None
+
+
+def _rank_delta_for_score(score: float, parlay_chain: dict[str, object]) -> int:
+    if score >= 105:
+        base = 42
+    elif score >= 88:
+        base = 28
+    elif score >= 70:
+        base = 12
+    else:
+        base = -6
+    chain_bonus = 0
+    if int(parlay_chain.get("chain_size") or 0) >= 5:
+        chain_bonus += 4
+    if int(parlay_chain.get("distinct_roles") or 0) >= 3:
+        chain_bonus += 4
+    return base + chain_bonus
+
+
+def _current_rank_points(conn, user_id: str, exclude_entry_id: str | None = None) -> int:
+    if exclude_entry_id:
+        row = conn.execute(
+            """
+            SELECT COALESCE(SUM(rank_delta), 0) AS points
+            FROM daily_blitz_entries
+            WHERE user_id = ? AND entry_id != ?
+            """,
+            (user_id, exclude_entry_id),
+        ).fetchone()
+    else:
+        row = conn.execute(
+            """
+            SELECT COALESCE(SUM(rank_delta), 0) AS points
+            FROM daily_blitz_entries
+            WHERE user_id = ?
+            """,
+            (user_id,),
+        ).fetchone()
+    return max(0, int(row["points"] or 0))
+
+
+def _rank_ladder_packet(points: int) -> dict[str, object]:
+    tier = _tier_for_points(points)
+    next_tier = _next_tier(points)
+    floor = int(tier["floor"])
+    if next_tier:
+        next_floor = int(next_tier["floor"])
+        progress = round((points - floor) / max(1, next_floor - floor), 3)
+        distance = next_floor - points
+    else:
+        next_floor = floor
+        progress = 1.0
+        distance = 0
+    return {
+        "mode": "Master Ladder",
+        "rank_points": points,
+        "tier": tier,
+        "next_tier": next_tier,
+        "progress": progress,
+        "points_to_next": distance,
+        "tiers": RANK_TIERS,
+        "rules": [
+            "Daily Blitz score moves rank points after recap reveal.",
+            "Five-card hands and role-diverse Skill Parlay chains add small rank bonuses.",
+            "Private chips do not affect rank points, salary cap, or scoring.",
+            "Ranks and chips have no cash value.",
+        ],
+        "return_reason": "Climb the next table by proving one cleaner captain read tomorrow.",
+    }
+
+
+def _rank_result_packet(
+    previous_points: int,
+    score: float,
+    parlay_chain: dict[str, object],
+) -> dict[str, object]:
+    delta = _rank_delta_for_score(score, parlay_chain)
+    current_points = max(0, previous_points + delta)
+    before = _tier_for_points(previous_points)
+    after = _tier_for_points(current_points)
+    ladder = _rank_ladder_packet(current_points)
+    promoted = str(before["key"]) != str(after["key"]) and current_points > previous_points
+    demoted = str(before["key"]) != str(after["key"]) and current_points < previous_points
+    if promoted:
+        headline = f"Promoted to {after['name']}."
+    elif demoted:
+        headline = f"Dropped to {after['name']}. Tighten the next captain read."
+    elif delta > 0:
+        headline = f"+{delta} RP toward {ladder['next_tier']['name'] if ladder['next_tier'] else 'Master shield'}."
+    else:
+        headline = f"{delta} RP. Use the recap lesson before the next lock."
+    return {
+        "previous_points": previous_points,
+        "delta": delta,
+        "rank_points": current_points,
+        "tier_before": before,
+        "tier_after": after,
+        "promoted": promoted,
+        "demoted": demoted,
+        "headline": headline,
+        "ladder": ladder,
+        "skill_gate": "Master climb rewards cleaner reads, roster balance, and recap discipline. Chips never buy rank.",
+    }
+
+
+def _rank_preview_packet(conn, user_id: str) -> dict[str, object]:
+    ladder = _rank_ladder_packet(_current_rank_points(conn, user_id))
+    return {
+        "state": "pre_lock",
+        "current": ladder,
+        "locked_hand_bonus": "A legal five-card, three-role hand can add up to +8 RP after reveal.",
+        "next_action": "Lock one coherent hand, then reveal the recap to move rank.",
+    }
+
+
 def _chip_options() -> list[int]:
     return [0, 5, 10, 20, 50]
 
