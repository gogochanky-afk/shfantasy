+                previous_points, delta, rank_points, rank_tier, score, percentile
+            )
+            VALUES(?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
+            """,
+            (
+                rank_event_id,
+                entry_id,
+                entry["user_id"],
+                slate.sport,
+                entry["slate_id"],
+                RANK_SEASON_ID,
+                RANK_RULES_VERSION,
+                result["previous_points"],
+                result["delta"],
