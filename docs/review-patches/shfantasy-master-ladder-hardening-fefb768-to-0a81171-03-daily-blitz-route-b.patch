+        VALUES(?, ?, ?, ?, ?, ?)
+        ON CONFLICT(user_id, sport, season_id, rules_version) DO UPDATE SET
+            rank_points = excluded.rank_points,
+            rank_tier = excluded.rank_tier,
+            updated_at = CURRENT_TIMESTAMP
+        """,
+        (
+            entry["user_id"],
+            slate.sport,
+            RANK_SEASON_ID,
+            RANK_RULES_VERSION,
+            result["rank_points"],
+            result["tier_after"]["name"],
+        ),
+    )
+    result["rank_event_id"] = rank_event_id
+    result["settled"] = True
+    result["idempotent_replay"] = False
+    return result
+
