+def _master_profile_packet(conn, user_id: str) -> dict[str, object]:
+    rows = conn.execute(
+        """
+        SELECT sport, rank_points, rank_tier
+        FROM daily_blitz_rank_state
+        WHERE user_id = ? AND season_id = ? AND rules_version = ?
+        ORDER BY rank_points DESC, sport
+        """,
+        (user_id, RANK_SEASON_ID, RANK_RULES_VERSION),
+    ).fetchall()
+    total = sum(int(row["rank_points"] or 0) for row in rows)
+    best = rows[0] if rows else None
+    return {
+        "season_id": RANK_SEASON_ID,
+        "rules_version": RANK_RULES_VERSION,
+        "combined_points": total,
+        "best_sport": best["sport"] if best else "",
+        "best_tier": best["rank_tier"] if best else "Rookie",
+        "sport_tables": [
+            {
+                "sport": row["sport"],
+                "rank_points": int(row["rank_points"] or 0),
+                "rank_tier": row["rank_tier"],
+            }
+            for row in rows
+        ],
+        "rule": "Sport tables keep separate rank state; Master Profile is an aggregate display only.",
+    }
